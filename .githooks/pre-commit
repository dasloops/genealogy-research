#!/usr/bin/env bash
# Refuse to commit any HTML page that isn't StatiCrypt-encrypted, so a readable
# family tree can never land in this public repo by accident.
status=0
while IFS= read -r f; do
  case "$f" in
    *.html|*.htm)
      # Encrypted pages pass, and so do the redirect pages that point to the new site.
      if ! git show ":$f" | grep -q 'staticrypt\|data-redirect'; then
        echo "BLOCKED: $f is not encrypted. Run ./encrypt.sh instead of committing readable pages." >&2
        status=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
exit $status
